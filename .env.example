# === Gemini ===
GEMINI_API_KEY=your_gemini_api_key_here
# 모델 (2.5는 신규 사용자 미제공, 3.5-flash-lite 권장 / 2026-09 검증)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
GEMINI_MIN_INTERVAL_SEC=4.0
GEMINI_MAX_RETRIES=5

# === Tavily Search (선택, 없으면 Gemini grounding fallback) ===
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic

# === Google Service Account ===
# 방법 A: JSON 문자열 그대로
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# 방법 B: 파일 경로
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
SHEET_ID=
CALENDAR_ID=primary
SHEET_TITLE=게임 외부행사 모음 (자동수집)
SHEET_TAB=events
# Sheet 생성 후 공유할 이메일 (선택)
SHARE_EMAIL=

# === 검색 쿼리 커스텀 (선택, 세미콜론 구분) ===
# SEARCH_QUERIES=한국 게임잼 2026;game jam 2026

# === 주간 캡 (신규 추가 기준) ===
WEEKLY_CAP=20

# === 스케줄 (주 1회 월요일 09:00 KST = 00:00 UTC) ===
# 변경 예: "0 0 * * *" (매일), "0 0 * * 1,4" (월/목), "0 0 1 * *" (매월 1일)
CRON_SCHEDULE=0 0 * * 1
TIMEZONE=Asia/Seoul

# === LangSmith (LangGraph Cloud 모니터링) ===
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=game event collector
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_TRACING_V2=true  # agent.py가 자동 설정
